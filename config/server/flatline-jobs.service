# Installed to /etc/systemd/system/ by bin/install.
# The Solid Queue worker that runs the checks. On stop it finishes the checks
# it is running (up to 40 seconds, see config/application.rb) before exiting.
#
# Starts through bash for the same reason as flatline-web.service: on SELinux
# systems (Fedora), systemd can't read the configuration file in a home folder.
[Unit]
Description=Flatline checks (Solid Queue)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
Environment=RAILS_ENV=production
ExecStart=/usr/bin/bash -c 'cd /home/deploy/flatline/current && set -a && . /home/deploy/flatline/shared/flatline.env && set +a && exec /home/deploy/.local/bin/mise exec -- bin/jobs'
Restart=always
RestartSec=2
TimeoutStopSec=60
SyslogIdentifier=flatline-jobs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
