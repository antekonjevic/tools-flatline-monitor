# Installed to /etc/caddy/Caddyfile by bin/install, with the real domain.
# Caddy gets and renews HTTPS certificates from Let's Encrypt on its own.
FLATLINE_HOST {
	encode zstd gzip

	reverse_proxy 127.0.0.1:3000 {
		# While Puma restarts during a deploy, wait for it instead of
		# showing an error.
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}
