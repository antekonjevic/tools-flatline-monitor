<%# Light, dark or follow the device. Changes only how this browser shows Flatline, so it's fine on the read-only board too. %>
<% current = theme_preference %>
<div class="theme-switch" role="group" aria-label="Color theme" data-controller="theme">
  <% { "light" => "Light", "dark" => "Dark", "system" => "Match device" }.each do |theme, label| %>
    <button type="button" class="theme-option" title="<%= label %>" aria-pressed="<%= theme == current %>"
            data-theme-target="option" data-theme-choice-param="<%= theme %>" data-action="theme#choose">
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
        <% case theme %>
        <% when "light" %>
          <circle cx="8" cy="8" r="2.75"/>
          <path d="M8 1.5v1.25M8 13.25v1.25M1.5 8h1.25M13.25 8h1.25M3.4 3.4l.9.9M11.7 11.7l.9.9M3.4 12.6l.9-.9M11.7 4.3l.9-.9"/>
        <% when "dark" %>
          <path d="M13.5 9.6A5.75 5.75 0 0 1 6.4 2.5a5.75 5.75 0 1 0 7.1 7.1Z"/>
        <% else %>
          <rect x="1.75" y="2.5" width="12.5" height="8.5" rx="1.5"/>
          <path d="M5.5 14h5M8 11v3"/>
        <% end %>
      </svg>
      <span class="sr-only"><%= label %></span>
    </button>
  <% end %>
</div>
